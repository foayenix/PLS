{
  "format_version": 1,
  "description": "Fictional credit-control evaluation data. Outcomes are training labels, not real financial policy.",
  "policy_version": "demo-v1",
  "policy": [
    {
      "id": "P1",
      "text": "A unique exact match supports an allocation recommendation. A unique partial payment supports a partial allocation recommendation and an open balance. Record both values."
    },
    {
      "id": "P2",
      "text": "A missing, unmatched or ambiguous reference requires review. A reference that points to multiple eligible invoices must show all candidates. The proposed allocation stays pending."
    },
    {
      "id": "P3",
      "text": "Disputed or closed invoices, mismatched currency and conflicting customer IDs require review. Check these conditions before comparing the amount to the open balance. Overpayments also require review."
    },
    {
      "id": "P4",
      "text": "A duplicate payment event requires review. A failed lookup leaves the case pending and requires review."
    },
    {
      "id": "P5",
      "text": "Zero or negative received amounts require review as invalid input. A new policy section can be used only when it is the active version."
    }
  ],
